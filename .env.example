# Copy to .env and fill in. .env is gitignored and is loaded by
# application.yml via spring.config.import.

# PG17 runs on 5432 (PG16 is on 5433 — do not use it).
JOBHUNT_DB_URL=jdbc:postgresql://localhost:5432/jobhunt
JOBHUNT_DB_USER=postgres
JOBHUNT_DB_PASSWORD=

# The UI and API both live here. The engine binds 127.0.0.1 only; opening the
# bind address requires adding an auth filter in the same change.
# See docs/DECISIONS.md #10.
JOBHUNT_PORT=6969

# Where the engine looks for the candidate profile.
# Phase 1 reads this from disk; a later HTTP ProfileSource will replace it.
JOBHUNT_PROFILE_PATH=.work/profile.json

# ── LinkedIn job alerts (optional) ───────────────────────────────────────
# Read from your own mailbox over IMAP. LinkedIn publishes no job-search API
# and scraping it is out; the alert mail it already sends you is the one route
# in that breaks no terms. See docs/DECISIONS.md #42.
#
# Gmail: turn on 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below. It is not your
# account password and can be revoked on its own.
#
# Strongly recommended: add a Gmail filter sending LinkedIn job alerts to their
# own label, and point JOBHUNT_MAIL_FOLDER at it. Searching one label instead
# of a whole inbox turns a slow sweep into an instant one.
JOBHUNT_MAIL_HOST=imap.gmail.com
JOBHUNT_MAIL_PORT=993
JOBHUNT_MAIL_USER=you@gmail.com
JOBHUNT_MAIL_PASSWORD=your-16-character-app-password
JOBHUNT_MAIL_FOLDER=INBOX
JOBHUNT_MAIL_LOOKBACK_DAYS=7
