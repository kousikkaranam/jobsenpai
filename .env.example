# Copy to .env and fill in. .env is gitignored and is loaded by
# application.yml via spring.config.import.

# PG17 runs on 5432 (PG16 is on 5433 — do not use it).
JOBHUNT_DB_URL=jdbc:postgresql://localhost:5432/jobhunt
JOBHUNT_DB_USER=postgres
JOBHUNT_DB_PASSWORD=

# The UI and API both live here. The engine binds 127.0.0.1 only; opening the
# bind address requires adding an auth filter in the same change.
# See docs/DECISIONS.md #10.
JOBHUNT_PORT=6969

# Where the engine looks for the candidate profile.
# Phase 1 reads this from disk; a later HTTP ProfileSource will replace it.
JOBHUNT_PROFILE_PATH=.work/profile.json
